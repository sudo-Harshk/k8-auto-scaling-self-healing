# ===== Project artifacts =====
# Original proposal pptx - not source
*.pptx

# ===== Captured/generated data (regenerated by the pipeline) =====
# Live run output is gitignored; explicit exceptions below commit thesis baselines
# and Locust summary stats as reproducibility evidence.
data/*
!data/.gitkeep
!data/baseline_metrics.csv
logs/*
!logs/.gitkeep
!logs/locust_baseline_stats.csv

